PORT=3000

# PNCP
PNCP_API_BASE_URL=https://pncp.gov.br/api/consulta
# Base opcional para itens/resultados; por padrão é derivada como https://pncp.gov.br/api/pncp/v1
PNCP_DATA_API_BASE_URL=https://pncp.gov.br/api/pncp/v1
# Aliases aceitos: PNCP_API_URL / PNCP_API_DATA_BASE_URL

# NVIDIA API compatível com OpenAI
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Alias aceito: NVIDIA_API_BASE_URL
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Webhook de leitura/escrita da planilha Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
# Alias aceito: GOOGLE_SHEETS_URL

# Telegram
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Alias aceito: TELEGRAM_API_URL
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: protege chamadas do workflow diário
CRON_SECRET=

# Limites operacionais opcionais
MAX_LEADS=200
PNCP_MAX_CONTRATACOES=100
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v1/localidades/estados




